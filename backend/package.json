    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.79.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
