{
  "name": "botornot-backend",
  "version": "1.0.0",
  "description": "Production-oriented backend for Bot or Not Turing Game",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
